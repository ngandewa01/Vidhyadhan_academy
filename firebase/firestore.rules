rules_version = '2';
// Vidyadhan app: each academy's records live under academies/{owner's sign-in id}; only that Google account can read or write them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /academies/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
