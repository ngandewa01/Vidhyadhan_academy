# Prototype needs no environment variables.
# Production integrations (examples – never commit real values):
# DATABASE_URL=
# SMS_PROVIDER_API_KEY=
# WHATSAPP_BSP_TOKEN=
# PAYMENT_GATEWAY_KEY_ID=
# PAYMENT_GATEWAY_KEY_SECRET=
# TELEGRAM_BOT_TOKEN=
# S3_ENDPOINT=

# Google reviews on the public website (Places API (New))
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# Locked brochure download (enquiry form unlocks a short-lived link)
# BROCHURE_FILE_URL=      private direct link to the brochure PDF (e.g. Vercel Blob); never shown to visitors
# BROCHURE_LINK_SECRET=   random string, at least 32 characters, used to sign download links

# Telegram community: announcements channel + student group, and the bot
# TELEGRAM_BOT_TOKEN=            from @BotFather (/newbot); server only, never shown to visitors
# TELEGRAM_SEND_KEY=             random text, 16+ characters; admins enter it in Settings to post
# TELEGRAM_WEBHOOK_SECRET=       random letters/numbers, 16+ characters; Telegram sends it with every update
# TELEGRAM_CHANNEL_ID=           announcements channel: -100... number or @username (post /id there to get it)
# TELEGRAM_GROUP_ID=             student group: -100... number (type /id in the group to get it)
# NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=   channel join link, e.g. https://t.me/your_channel (shown on the site)
# NEXT_PUBLIC_TELEGRAM_GROUP_URL=     group join link, e.g. https://t.me/+AbCdEf (shown on the site)
